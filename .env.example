# Password for /admin. Required, or the settings page stays locked.
ADMIN_PASSWORD=

# Optional, for saving from the deployed site on Vercel.
# A fine-grained GitHub token with "Contents: Read and write" on the site's repo.
GITHUB_TOKEN=
# owner/repo, for example surafelx/surafel-site
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional, for the visitor count on Vercel. Without these the count resets on each deploy.
# Upstash Redis (free tier on the Vercel marketplace). Vercel's KV_REST_API_URL / KV_REST_API_TOKEN names work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# GITHUB_TOKEN above also powers the commit count in the Right now panel; without it only public pushes are shown.
